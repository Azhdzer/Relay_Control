# ─── Relay Controller — Configuration ────────────────────────────────────────
# Edit this file, then start: python pc_relay_script.py

# Full path to the measurement file (OdczytTH .txt, updated every ~1 min)
DATA_FILE=D:\Sterowanie zasilaniem\test_data_many_channels_on.txt

# Arduino serial port (check Device Manager → Ports)
SERIAL_PORT=COM8

# Baud rate — must match Arduino sketch (default 9600)
BAUD_RATE=9600

# How often to check the file and evaluate conditions [seconds]
POLL_INTERVAL=30

# Maximum allowed 15-min dew-point drift to allow relay ON [°C]
ROZTDP_THRESHOLD=0.35

# Minimum unbroken setpoint stability before relay can close [hours]
SETPOINT_STABLE_HOURS=2.0

# After relay turns ON, keep it ON for at least this many minutes
# (except hard fail-safe errors like stale/missing data)
MIN_ON_HOLD_MINUTES=15

# If newest data row is older than this → treat as stale → relay OFF [minutes]
STALE_DATA_MINUTES=5

# Directory for relay_events.log  (use . for same folder as script)
LOG_DIR=D:\Sterowanie zasilaniem\release\20260426_223659
LOG_ROOT_DIR=D:/Sterowanie zasilaniem/release
