#include <Arduino.h>
#include <Wire.h>

// I2C Scanner — загрузи, открой Serial Monitor @ 9600
// Покажет адрес подключённого устройства (0x27 или 0x3F для HW-61)

void setup() {
    Serial.begin(9600);
    Wire.begin();
    Serial.println("I2C Scanner...");
    delay(500);

    uint8_t found = 0;
    for (uint8_t addr = 1; addr < 127; addr++) {
        Wire.beginTransmission(addr);
        uint8_t err = Wire.endTransmission();
        if (err == 0) {
            Serial.print("Найдено устройство: 0x");
            if (addr < 16) Serial.print("0");
            Serial.println(addr, HEX);
            found++;
        }
    }
    if (found == 0)
        Serial.println("Устройства не найдены! Проверь SDA(A4) и SCL(A5).");
    else
        Serial.println("Готово.");
}

void loop() {}
